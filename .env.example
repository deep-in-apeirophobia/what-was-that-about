# Copy to .env (gitignored) to enable telemetry in local builds. CI sets these as
# GitHub Actions variables/secrets instead. Leave empty to build without telemetry.

# PostHog project token (public, safe in client apps) and host
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Sentry DSN for crash reports
SENTRY_DSN=
# release | nightly | dev (defaults to "dev" in debug builds)
WWTA_CHANNEL=
